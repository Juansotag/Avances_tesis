% beamerthemeELANOM.sty — Tema limpio, blanco, barras azules
\ProvidesPackage{beamerthemeELANOM}[2026/08/10 ELA-NOM Clean White Theme]
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage{amsmath}

% ── Paleta de color ────────────────────────────────────────────────────────────
\definecolor{barBlue}{HTML}{1B4D8E}       % barra superior/inferior
\definecolor{keyBlue}{HTML}{2E6DB4}       % texto clave / tablas header
\definecolor{accentBlue}{HTML}{5B9BD5}    % viñetas secundarias
\definecolor{alertRed}{HTML}{C0392B}      % advertencia
\definecolor{okGreen}{HTML}{1A7A4A}       % positivo
\definecolor{goldNum}{HTML}{996600}       % cifras destacadas
\definecolor{bgWhite}{HTML}{FFFFFF}
\definecolor{darkText}{HTML}{1A1A2E}
\definecolor{subtleGray}{HTML}{6B7280}
\definecolor{tableBand}{HTML}{EBF2FB}     % filas alternas de tabla

% ── Colores de elementos Beamer ────────────────────────────────────────────────
\setbeamercolor{background canvas}{bg=bgWhite}
\setbeamercolor{normal text}{fg=darkText}
\setbeamercolor{structure}{fg=barBlue}
\setbeamercolor{frametitle}{fg=bgWhite, bg=barBlue}
\setbeamercolor{title}{fg=barBlue}
\setbeamercolor{subtitle}{fg=keyBlue}
\setbeamercolor{author}{fg=subtleGray}
\setbeamercolor{institute}{fg=subtleGray}
\setbeamercolor{date}{fg=subtleGray}
\setbeamercolor{footline}{fg=bgWhite, bg=barBlue}
\setbeamercolor{item}{fg=barBlue}
\setbeamercolor{subitem}{fg=accentBlue}
\setbeamercolor{subsubitem}{fg=subtleGray}
\setbeamercolor{alerted text}{fg=alertRed}
\setbeamercolor{block title}{fg=bgWhite, bg=keyBlue}
\setbeamercolor{block body}{fg=darkText, bg=tableBand}
\setbeamercolor{block title alerted}{fg=bgWhite, bg=alertRed}
\setbeamercolor{block body alerted}{fg=darkText, bg=bgWhite}
\setbeamercolor{block title example}{fg=bgWhite, bg=okGreen}
\setbeamercolor{block body example}{fg=darkText, bg=bgWhite}

% ── Fuentes ────────────────────────────────────────────────────────────────────
\setbeamerfont{title}{size=\Large, series=\bfseries}
\setbeamerfont{subtitle}{size=\normalsize, series=\normalfont}
\setbeamerfont{frametitle}{size=\normalsize, series=\bfseries}
\setbeamerfont{footline}{size=\scriptsize}
\setbeamerfont{block title}{size=\small, series=\bfseries}

% ── Barra superior (título de diapositiva) ─────────────────────────────────────
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{beamercolorbox}[wd=\paperwidth, ht=2.6ex, dp=1.2ex, leftskip=0.7cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
    \ifx\insertframesubtitle\@empty\else
      \hfill{\color{accentBlue}\small\textit{\insertframesubtitle}}%
    \fi
  \end{beamercolorbox}%
  \nointerlineskip
}

% ── Barra inferior (nombre + número de diapositiva) ────────────────────────────
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth, ht=2.25ex, dp=1.2ex,
                         leftskip=0.7cm, rightskip=0.7cm]{footline}%
    Juan Sotelo Aguilar \hspace{0.4em}|\hspace{0.4em} Maestría en Analítica Aplicada%
    \hfill%
    \insertframenumber\,/\,\inserttotalframenumber%
  \end{beamercolorbox}%
}

% ── Viñetas ────────────────────────────────────────────────────────────────────
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize item}{\color{barBlue}\small$\blacktriangleright$}
\setbeamertemplate{itemize subitem}{\color{accentBlue}\small$\triangleright$}
\setbeamertemplate{itemize subsubitem}{\color{subtleGray}\tiny$\bullet$}

% ── Comandos de utilidad ───────────────────────────────────────────────────────
\newcommand{\kw}[1]{{\color{barBlue}\textbf{#1}}}        % keyword azul
\newcommand{\num}[1]{{\color{goldNum}\textbf{#1}}}        % cifra destacada
\newcommand{\alrt}[1]{{\color{alertRed}\textbf{#1}}}      % alerta
\newcommand{\ok}[1]{{\color{okGreen}\textbf{#1}}}         % positivo
\newcommand{\corr}[1]{{\color{keyBlue}\textit{#1}}}       % corrección del jurado
