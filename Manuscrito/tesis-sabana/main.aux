\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Distribución de la fracción acumulada de interacciones ($n_t / n_{\mathop {\mathgroup \symoperators m\acute  {a}x}}$) por Día Relativo, sobre el panel completo de 1,922 publicaciones. La línea roja muestra la mediana: en el Día~0 ya se acumula el 72\% del total final; al Día~3, el 98\%. La dispersión en los días iniciales refleja la heterogeneidad entre publicaciones, razón por la que el $R^2$ global es bajo pero el modelo promedio es válido.}}{19}{figure.caption.8}\protected@file@percent }
\newlabel{fig:distribucion_fracciones}{{5.3}{19}{Distribución de la fracción acumulada de interacciones ($n_t / n_{\max }$) por Día Relativo, sobre el panel completo de 1,922 publicaciones. La línea roja muestra la mediana: en el Día~0 ya se acumula el 72\% del total final; al Día~3, el 98\%. La dispersión en los días iniciales refleja la heterogeneidad entre publicaciones, razón por la que el $R^2$ global es bajo pero el modelo promedio es válido}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces Ajuste del modelo Weibull con \textit  {offset} temporal por plataforma. Puntos negros: mediana empírica. Área azul: rango intercuartílico (IQR) empírico. Curva roja: modelo calibrado. Los parámetros $k$, $\alpha $ y $t_0$ de cada plataforma se detallan en la Tabla~\ref {tab:weibull_params}.}}{19}{figure.caption.9}\protected@file@percent }
\newlabel{fig:weibull_por_plataforma}{{5.4}{19}{Ajuste del modelo Weibull con \textit {offset} temporal por plataforma. Puntos negros: mediana empírica. Área azul: rango intercuartílico (IQR) empírico. Curva roja: modelo calibrado. Los parámetros $k$, $\alpha $ y $t_0$ de cada plataforma se detallan en la Tabla~\ref {tab:weibull_params}}{figure.caption.9}{}}
