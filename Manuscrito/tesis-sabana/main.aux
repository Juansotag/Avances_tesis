\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Ejemplos de reconstrucción histórica de interacciones con el modelo Weibull calibrado. \textbf  {Izquierda}: publicación de Facebook con 50,000 interacciones totales conocidas; el modelo distribuye las interacciones nuevas por día (barras) y la fracción acumulada (curva roja). \textbf  {Derecha}: publicación de Instagram con 43,000 interacciones medidas el Día~10; el modelo infiere el total final y reconstruye la curva completa.}}{20}{figure.caption.11}\protected@file@percent }
